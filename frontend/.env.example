# Supabase (Postgres + Auth + Storage + Edge Functions backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GenLayer Intelligent Contract (StudioNet) — set once the contract is deployed.
# Do NOT hardcode a placeholder address anywhere else in the codebase; leave blank until provided.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# WalletConnect / RainbowKit (get a free project ID at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
