# Vertex — environment variable reference (no real values; copy to .env.local per app)

# --- Supabase (frontend, e.g. Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only / Edge Functions — set via `supabase secrets set`, never in frontend .env) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into every Edge Function by the
# Supabase platform and do NOT need to be set manually; listed here for local `functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Wallet auth (backend/supabase/functions/wallet-auth) ---
WALLET_EMAIL_DOMAIN=wallet.vertex.local

# --- GenLayer Intelligent Contract (backend/supabase/functions/sync-chain-state) ---
# Left blank until the user deploys the contract manually via genlayer-cli on StudioNet.
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_RPC_URL=
GENLAYER_CHAIN=studionet

# --- OAuth providers for social identity linking (configured in Supabase Dashboard -> Auth -> Providers,
# NOT read directly by app code — listed here for reference/setup only) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Frontend wallet connection (Next.js / wagmi / WalletConnect) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
